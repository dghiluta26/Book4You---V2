# Copy this file to .env and fill in your own values. NEVER commit .env.

# --- App (Step 3) ---
APP_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Database: Supabase Postgres (Step 4) ---
# Supabase > Connect > Session pooler (IPv4). Paste the URI as-is, with your password in it.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Supabase Auth (Step 7) ---
# Project URL (Supabase > Project Settings > API), e.g. https://abcdefgh.supabase.co
# Login tokens are verified with the project's PUBLIC keys, so no secret is needed here.
SUPABASE_URL=

# --- LLM provider (Step 8) ---
LLM_API_KEY=
