# Copy this file to .env and fill in your own values. NEVER commit .env.

# --- App (Step 3) ---
APP_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Database: Supabase Postgres (Step 4) ---
DATABASE_URL=

# --- Supabase Auth (Step 7) ---
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# --- LLM provider (Step 8) ---
LLM_API_KEY=
