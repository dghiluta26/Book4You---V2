# Copy this file to .env.local (it is git-ignored) and adjust if needed.
# URL of the FastAPI backend, as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth: dashboard > Connect (or Project Settings > API keys).
# Both values are PUBLIC and safe in the browser. NEVER put an sb_secret_ / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
